cens.model = "km",
conf.int = FALSE,
null.model = FALSE
)
auc_k <- as.data.frame(score_k$AUC$score)
auc_k <- auc_k[auc_k$model == "S3VS", c("times", "AUC")]
cv_results$AUC_1yr[k] <- auc_k$AUC[match(auc_times[1], auc_k$times)]
cv_results$AUC_3yr[k] <- auc_k$AUC[match(auc_times[2], auc_k$times)]
cv_results$AUC_5yr[k] <- auc_k$AUC[match(auc_times[3], auc_k$times)]
brier_k <- as.data.frame(score_k$Brier$score)
brier_k <- brier_k[brier_k$model == "S3VS", c("times", "Brier")]
cv_results$IBS[k] <- with(
brier_k,
sum(diff(times) *
(head(Brier, -1) + tail(Brier, -1)) / 2) /
(max(times) - min(times))
)
}
cv_results
CV_summary <- data.frame(
measure = c("Number selected", "C-index", "AUC at 1 year",
"AUC at 3 years", "AUC at 5 years", "IBS"),
mean = c(
mean(cv_results$n_selected, na.rm = TRUE),
mean(cv_results$C_index, na.rm = TRUE),
mean(cv_results$AUC_1yr, na.rm = TRUE),
mean(cv_results$AUC_3yr, na.rm = TRUE),
mean(cv_results$AUC_5yr, na.rm = TRUE),
mean(cv_results$IBS, na.rm = TRUE)
),
sd = c(
sd(cv_results$n_selected, na.rm = TRUE),
sd(cv_results$C_index, na.rm = TRUE),
sd(cv_results$AUC_1yr, na.rm = TRUE),
sd(cv_results$AUC_3yr, na.rm = TRUE),
sd(cv_results$AUC_5yr, na.rm = TRUE),
sd(cv_results$IBS, na.rm = TRUE)
)
)
CV_summary
rm(list = ls())
#BiocManager::install("curatedOvarianData")
##----> Load the TCGA ovarian cancer dataset
library(curatedOvarianData)
library(Biobase)
library(survival)
library(riskRegression)
library(snowfall)
data(TCGA_eset)
dim(exprs(TCGA_eset))
# [1] 13104   578
##----> Predictor matrix: patients x genes
X <- t(exprs(TCGA_eset))
## Clinical information
clinical <- pData(TCGA_eset)
all.equal(rownames(clinical),rownames(X))
# [1] TRUE
##----> Examine available clinical variables
colnames(clinical)
#  [1] "alt_sample_name"                     "unique_patient_ID"                   "sample_type"
#  [4] "histological_type"                   "primarysite"                         "arrayedsite"
#  [7] "summarygrade"                        "summarystage"                        "tumorstage"
# [10] "substage"                            "grade"                               "age_at_initial_pathologic_diagnosis"
# [13] "pltx"                                "tax"                                 "neo"
# [16] "days_to_tumor_recurrence"            "recurrence_status"                   "days_to_death"
# [19] "vital_status"                        "os_binary"                           "relapse_binary"
# [22] "site_of_tumor_first_recurrence"      "primary_therapy_outcome_success"     "debulking"
# [25] "percent_normal_cells"                "percent_stromal_cells"               "percent_tumor_cells"
# [28] "batch"                               "flag"                                "flag_notes"
# [31] "uncurated_author_metadata"
##----> Overall-survival outcome
time <- clinical$days_to_death
status <- as.integer(clinical$vital_status == "deceased")
##----> Retain patients with usable survival information
keep <- !is.na(time) & !is.na(status)
X <- X[keep, , drop = FALSE]
time <- time[keep]
status <- status[keep]
##----> Two low-correlation TCGA expression outliers documented by the package.
outliers_id <- match(c("TCGA.24.1927", "TCGA.31.1955"), rownames(X))
X <- X[-outliers_id, ]
time <- time[-outliers_id]
status <- status[-outliers_id]
##----> Remove probes mapped to multiple genes, whose labels contain "///"
keep_genes <- !grepl("///", colnames(X), fixed = TRUE)
X <- X[,keep_genes]
dim(X)
# [1]   555 12211
##----> 5-fold cross-validation for internal validation
source("/Users/nsanyal/Dropbox/Statistics/Research_Nil/Project-08B-S3VS/R_package_S3VS/S3VS_1.1/R/S3VS.R")
set.seed(20260715)
K <- 5
fold_id <- integer(length(status))
fold_id[status == 0] <- sample(rep(1:K, length.out = sum(status == 0)))
fold_id[status == 1] <- sample(rep(1:K, length.out = sum(status == 1)))
table(fold_id, status)
auc_times <- c(365, 3 * 365, 5 * 365)
evaluation_times <- sort(unique(c(
seq(90, 5 * 365, by = 90),
auc_times
)))
## Each fold is computed on one snowfall slave
fold_worker <- function(k) {
cat("\n================ Fold", k, "of", K, "================\n")
te_id <- which(fold_id == k)
tr_id <- which(fold_id != k)
## Standardize using the current training fold only
train_mean <- colMeans(X[tr_id, , drop = FALSE])
train_sd <- apply(X[tr_id, , drop = FALSE], 2, sd)
good_genes <- is.finite(train_mean) & is.finite(train_sd) & train_sd > 0
X_tr <- scale(
X[tr_id, good_genes, drop = FALSE],
center = train_mean[good_genes],
scale = train_sd[good_genes]
)
X_te <- scale(
X[te_id, good_genes, drop = FALSE],
center = train_mean[good_genes],
scale = train_sd[good_genes]
)
storage.mode(X_tr) <- storage.mode(X_te) <- "double"
## A nonfinite test value is replaced by the training mean on the scaled scale
X_te[!is.finite(X_te)] <- 0
y_tr <- list(
time = time[tr_id],
status = status[tr_id]
)
## S3VS must be rerun within every training fold
fit_k <- S3VS(
y = y_tr, X = X_tr, family = "survival", surv_model = "COX",
method_xy = "topk", param_xy = list(k = 1),
method_xx = "topk", param_xx = list(k = 5),
vsel_method = "LASSO", lambda = "lambda.min", alpha = 1,
method_sel = "conservative", method_rem = "conservative_begin",
m = 100, nskip = 3, verbose = TRUE, seed = 20260715 + k
)
selected_vars_k <- fit_k$selected
fold_result <- data.frame(
fold = k,
n_selected = length(selected_vars_k),
C_index = NA_real_,
AUC_1yr = NA_real_,
AUC_3yr = NA_real_,
AUC_5yr = NA_real_,
IBS = NA_real_
)
if (length(selected_vars_k) == 0) {
return(list(result = fold_result, selected = selected_vars_k))
}
## Post-selection Cox model in the current training fold
train_dat <- droplevels(na.omit(data.frame(
time = time[tr_id],
status = status[tr_id],
tumorstage = factor(clinical[rownames(X_tr), "tumorstage"]),
debulking = factor(clinical[rownames(X_tr), "debulking"]),
X_tr[, selected_vars_k, drop = FALSE],
check.names = FALSE
)))
test_dat <- na.omit(data.frame(
time = time[te_id],
status = status[te_id],
tumorstage = factor(
clinical[rownames(X_te), "tumorstage"],
levels = levels(train_dat$tumorstage)
),
debulking = factor(
clinical[rownames(X_te), "debulking"],
levels = levels(train_dat$debulking)
),
X_te[, selected_vars_k, drop = FALSE],
check.names = FALSE
))
fit_cox_k <- survival::coxph(
survival::Surv(time, status) ~ .,
data = train_dat,
x = TRUE,
y = TRUE,
model = TRUE
)
## Out-of-fold C-index
test_dat$risk_score <- predict(
fit_cox_k,
newdata = test_dat,
type = "lp"
)
test_dat <- test_dat[is.finite(test_dat$risk_score), , drop = FALSE]
fold_result$C_index <- survival::concordance(
survival::Surv(time, status) ~ risk_score,
data = test_dat,
reverse = TRUE
)$concordance
## Out-of-fold time-dependent AUC and IBS
score_k <- riskRegression::Score(
object = list(S3VS = fit_cox_k),
formula = survival::Surv(time, status) ~ 1,
data = test_dat,
metrics = c("AUC", "Brier"),
times = evaluation_times,
cens.model = "km",
conf.int = FALSE,
null.model = FALSE
)
auc_k <- as.data.frame(score_k$AUC$score)
auc_k <- auc_k[auc_k$model == "S3VS", c("times", "AUC")]
fold_result$AUC_1yr <- auc_k$AUC[match(auc_times[1], auc_k$times)]
fold_result$AUC_3yr <- auc_k$AUC[match(auc_times[2], auc_k$times)]
fold_result$AUC_5yr <- auc_k$AUC[match(auc_times[3], auc_k$times)]
brier_k <- as.data.frame(score_k$Brier$score)
brier_k <- brier_k[brier_k$model == "S3VS", c("times", "Brier")]
fold_result$IBS <- with(
brier_k,
sum(diff(times) *
(head(Brier, -1) + tail(Brier, -1)) / 2) /
(max(times) - min(times))
)
list(result = fold_result, selected = selected_vars_k)
}
## Run the five CV folds in parallel using five snowfall slaves
sfInit(parallel = TRUE, cpus = 5, type = "SOCK")
sfLibrary(survival)
sfLibrary(riskRegression)
sfLibrary(glmnet)
## Load the S3VS functions on every slave
sfSource("/Users/nsanyal/Dropbox/Statistics/Research_Nil/Project-08B-S3VS/R_package_S3VS/S3VS_1.1/R/S3VS.R")
## Export the data and settings required by each fold
sfExport(
"X", "clinical", "time", "status", "fold_id",
"auc_times", "evaluation_times", "K"
)
cv_out <- tryCatch(
sfLapply(1:K, fold_worker),
finally = sfStop()
)
rm(list = ls())
