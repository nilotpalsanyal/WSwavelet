fdp_conditional_boxplot <- ggplot(box_raw[is.finite(FDP_conditional)], aes(x = selector, y = FDP_conditional, fill = approach, group = method)) + geom_boxplot(outlier.size = 0.2, position = position_dodge(width = 0.8)) + facet_wrap(~ scenario, ncol = 4) + scale_y_continuous(limits = c(0, 1)) + scale_fill_brewer(palette = "Set2") + labs(x = "Selector", y = "FDP conditional on nonempty selection", fill = "Approach", title = "Conditional FDP distributions among nonempty selections") + theme_report()
save_plot(fdp_conditional_boxplot, "LM_FigureS2_FDP_conditional_boxplots", 16, 10)
betaerr_boxplot <- ggplot(box_raw[is.finite(betaerr)], aes(x = selector, y = betaerr, fill = approach, group = method)) + geom_boxplot(outlier.size = 0.2, position = position_dodge(width = 0.8)) + facet_wrap(~ scenario, ncol = 4) + scale_fill_brewer(palette = "Set2") + labs(x = "Selector", y = "Coefficient error", fill = "Approach", title = "Replicate-level coefficient error") + theme_report()
save_plot(betaerr_boxplot, "LM_FigureS3_coefficient_error", 16, 10)
covariance_plot_data <- covariance_summary
covariance_plot_data[, scenario := factor(scenario, levels = covariance_scenarios)]
