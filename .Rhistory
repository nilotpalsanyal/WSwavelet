save_plot(covariance_plot, "LM_FigureS4_covariance_structures", 15, 7)
effect_long <- rbindlist(list(effect_summary[, .(approach, selector, metric = "TPR", estimate = TPR_mean, lower = TPR_lower, upper = TPR_upper)], effect_summary[, .(approach, selector, metric = "Mean FDP", estimate = FDP_unconditional_mean, lower = FDP_unconditional_lower, upper = FDP_unconditional_upper)], effect_summary[, .(approach, selector, metric = "P(nonempty)", estimate = P_nonempty_mean, lower = P_nonempty_lower, upper = P_nonempty_upper)]), fill = TRUE)
effect_plot <- ggplot(effect_long, aes(x = selector, y = estimate, colour = approach, group = approach)) + geom_line(position = position_dodge(width = 0.25)) + geom_point(position = position_dodge(width = 0.25), size = 2) + geom_errorbar(aes(ymin = lower, ymax = upper), width = 0.1, position = position_dodge(width = 0.25)) + facet_wrap(~ metric, scales = "free_y") + scale_color_brewer(palette = "Dark2") + labs(x = "Selector", y = "Mean estimate", colour = "Approach", title = "Descriptive approach-by-selector effects", subtitle = "Means are pooled over named scenarios at the primary n, p, and moderate-signal setting") + theme_report()
