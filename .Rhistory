target_snr_mean = mean_or_na(target_snr), target_snr_se = mc_se(target_snr),
signal_snr_mean = mean_or_na(signal_snr), signal_snr_se = mc_se(signal_snr),
response_variance_mean = mean_or_na(response_variance), response_variance_se = mc_se(response_variance),
selection_success_rate = mean_or_na(fit_ok), selection_success_rate_se = mc_se(fit_ok),
history_success_rate = mean_or_na(history_ok), history_success_rate_se = mc_se(history_ok),
postfit_success_rate = mean_or_na(postfit_ok), postfit_success_rate_se = mc_se(postfit_ok),
mean_iterations = mean_or_na(n_iterations), mean_iterations_se = mc_se(n_iterations),
P_nonempty_mean = mean_or_na(nonempty), P_nonempty_se = mc_se(nonempty),
selected_size_mean = mean_or_na(selected_model_size), selected_size_mean_se = mc_se(selected_model_size),
selected_size_median = median_or_na(selected_model_size), selected_size_median_se = median_mc_se(selected_model_size),
TPR_mean = mean_or_na(TPR), TPR_se = mc_se(TPR),
P_sure_screening_mean = mean_or_na(sure_screening), P_sure_screening_se = mc_se(sure_screening),
FDP_conditional_mean = mean_or_na(FDP_conditional), FDP_conditional_se = mc_se(FDP_conditional),
FDP_unconditional_mean = mean_or_na(FDP_unconditional), FDP_unconditional_se = mc_se(FDP_unconditional),
precision_mean = mean_or_na(precision), precision_se = mc_se(precision),
FP_mean = mean_or_na(FP), FP_se = mc_se(FP),
FN_mean = mean_or_na(FN), FN_se = mc_se(FN),
Fscore_mean = mean_or_na(Fscore), Fscore_se = mc_se(Fscore),
betaerr_mean = mean_or_na(betaerr), betaerr_se = mc_se(betaerr),
test_MSE_mean = mean_or_na(test_MSE), test_MSE_se = mc_se(test_MSE),
runtime_mean = mean_or_na(runtime_min), runtime_se = mc_se(runtime_min),
full_run_runtime_mean = mean_or_na(full_run_runtime_min), full_run_runtime_se = mc_se(full_run_runtime_min)
), by = by]
}
add_ci <- function(x, metric, lower = -Inf, upper = Inf, mean_name = paste0(metric, "_mean"), se_name = paste0(metric, "_se")) {
x[, (paste0(metric, "_lower")) := pmax(lower, get(mean_name) - 1.96 * get(se_name))]
x[, (paste0(metric, "_upper")) := pmin(upper, get(mean_name) + 1.96 * get(se_name))]
invisible(x)
}
probability_metrics <- c("selection_success_rate", "history_success_rate", "postfit_success_rate", "P_nonempty", "P_sure_screening", "TPR", "FDP_conditional", "FDP_unconditional", "precision", "Fscore")
nonnegative_metrics <- c("FP", "FN", "betaerr", "test_MSE", "runtime")
add_all_ci <- function(x) {
for (metric in probability_metrics) add_ci(x, metric, 0, 1)
for (metric in nonnegative_metrics) add_ci(x, metric, 0, Inf)
add_ci(x, "selected_size_mean", 0, Inf, mean_name = "selected_size_mean", se_name = "selected_size_mean_se")
add_ci(x, "selected_size_median", 0, Inf, mean_name = "selected_size_median", se_name = "selected_size_median_se")
invisible(x)
}
format_number <- function(x, digits = 3) ifelse(is.finite(x), formatC(x, format = "f", digits = digits), "NA")
format_mean_se <- function(x, se, digits = 3) ifelse(is.finite(x), paste0(format_number(x, digits), " (", format_number(se, digits), ")"), "NA")
latex_safe <- function(x) gsub("_", "-", as.character(x), fixed = TRUE)
format_table_column <- function(z) {
if (!is.numeric(z)) return(latex_safe(z))
if (all(is.na(z) | z == floor(z))) formatC(z, format = "f", digits = 0) else formatC(z, format = "f", digits = 3)
}
write_latex_table <- function(x, file, caption, label, size = "\\small") {
x <- as.data.frame(x, check.names = FALSE, stringsAsFactors = FALSE)
x[] <- lapply(x, format_table_column)
alignment <- paste0("l", paste(rep("r", max(0L, ncol(x) - 1L)), collapse = ""))
header <- paste(latex_safe(names(x)), collapse = " & ")
rows <- if (nrow(x)) apply(x, 1L, paste, collapse = " & ") else character(0)
lines <- c("\\begin{table}[t]", "\\centering", size, paste0("\\caption{", caption, "}"), paste0("\\label{", label, "}"), paste0("\\begin{tabular}{", alignment, "}"), "\\toprule", paste0(header, " \\\\"), "\\midrule", paste0(rows, " \\\\"), "\\bottomrule", "\\end{tabular}", "\\end{table}")
writeLines(lines, file)
}
write_table_pair <- function(x, stem, caption, label) {
fwrite(x, file.path(tables_dir, paste0(stem, ".csv")))
write_latex_table(x, file.path(tables_dir, paste0(stem, ".tex")), caption, label)
}
theme_report <- function() {
theme_bw(base_size = 10) + theme(legend.position = "bottom", legend.box = "vertical", strip.text = element_text(face = "bold"), axis.text.x = element_text(angle = 45, hjust = 1))
}
save_plot <- function(plot, stem, width, height) ggsave(file.path(figures_dir, paste0(stem, ".pdf")), plot, width = width, height = height, units = "in", device = "pdf")
#------ complete condition-level summaries
