cell_summary[, selector := unname(method_selector[method])]
setorder(cell_summary, scenario, signal_regime, n, p, method)
fwrite(cell_summary, file.path(tables_dir, "LM_Supp_TableS4_full_condition_summaries.csv"))
names(raw)
add_ci <- function(x, metric, lower = -Inf, upper = Inf, mean_name = NULL, se_name = NULL) {
if (is.null(mean_name)) mean_name <- if (paste0(metric, "_mean") %in% names(x)) paste0(metric, "_mean") else metric
if (is.null(se_name)) se_name <- paste0(metric, "_se")
x[, (paste0(metric, "_lower")) := pmax(lower, get(mean_name) - 1.96 * get(se_name))]
x[, (paste0(metric, "_upper")) := pmin(upper, get(mean_name) + 1.96 * get(se_name))]
invisible(x)
}
