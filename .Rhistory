## Run the five CV folds in parallel using five snowfall slaves
sfInit(parallel = TRUE, cpus = 5, type = "SOCK")
sfLibrary(survival)
sfLibrary(riskRegression)
sfLibrary(glmnet)
## Load the S3VS functions on every slave
sfSource("/Users/nsanyal/Dropbox/Statistics/Research_Nil/Project-08B-S3VS/R_package_S3VS/S3VS_1.1/R/S3VS.R")
## Export the data and settings required by each fold
sfExport(
"X", "clinical", "time", "status", "fold_id",
"auc_times", "evaluation_times", "K"
)
cv_out <- tryCatch(
sfLapply(1:K, fold_worker),
finally = sfStop()
)
## Reconstruct the same output objects as in the sequential version
cv_results <- do.call(rbind, lapply(cv_out, `[[`, "result"))
cv_results <- cv_results[order(cv_results$fold), , drop = FALSE]
selected_vars_cv <- lapply(cv_out, `[[`, "selected")
selected_vars_cv <- selected_vars_cv[order(vapply(cv_out, function(z) z$result$fold, integer(1)))]
cv_results
CV_summary <- data.frame(
measure = c("Number selected", "C-index", "AUC at 1 year",
"AUC at 3 years", "AUC at 5 years", "IBS"),
mean = c(
